# PostHog MCP — copy to .env and fill in values. Never commit real keys.

# mock (default) | live  — STDIO / local only. Remote HTTP uses request headers.
POSTHOG_MODE=mock

# Project API key (phc_...) — required for live capture / decide (STDIO)
POSTHOG_API_KEY=

# Capture / decide host
POSTHOG_HOST=https://us.i.posthog.com

# Personal API key (phx_...) — required for live private REST + query tools (STDIO)
POSTHOG_PERSONAL_API_KEY=

# Numeric project id — required for live private API paths (STDIO)
POSTHOG_PROJECT_ID=

# --- Remote HTTP MCP (npm run dev:http / Railway) ---
# Required in production. Clients send: Authorization: Bearer <MCP_API_KEY>
MCP_API_KEY=
# Listen port (Railway sets PORT automatically)
PORT=8787
# Optional comma-separated browser Origins allowed for Streamable HTTP
MCP_ALLOWED_ORIGINS=
# Optional extra PostHog hostnames (comma-separated) beyond us/eu cloud defaults
POSTHOG_ALLOWED_HOSTS=

# --- Agent evaluations (not required for npm test / npm run eval) ---

# Active provider: gemini | groq (default: gemini if GEMINI_API_KEY set, else groq)
EVAL_PROVIDER=gemini

# Gemini (recommended on free tier — ~250k TPM for Flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_TPM_LIMIT=250000

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TPM_LIMIT=8000
