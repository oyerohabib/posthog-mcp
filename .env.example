# PostHog MCP — copy to .env and fill in values. Never commit real keys.

# mock (default) | live  — STDIO / local only
POSTHOG_MODE=mock

# Project API key (phc_...) — STDIO live capture / decide
POSTHOG_API_KEY=

# Capture / decide host
POSTHOG_HOST=https://us.i.posthog.com

# Personal API key (phx_...) — STDIO live private REST
POSTHOG_PERSONAL_API_KEY=

# Numeric project id — STDIO live private API
POSTHOG_PROJECT_ID=

# --- Remote HTTP MCP (npm run dev:http / Railway) ---
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
# Canonical MCP resource URL (JWT audience) — production: https://YOUR-DOMAIN/mcp
MCP_RESOURCE_URL=http://127.0.0.1:8787/mcp

# WorkOS AuthKit (MCP OAuth authorization server)
WORKOS_AUTHKIT_DOMAIN=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# Encrypt PostHog OAuth tokens at rest (32 bytes as 64-char hex)
TOKEN_ENCRYPTION_KEY=

# Postgres (Railway). If unset, in-memory store is used (dev/tests only).
DATABASE_URL=

# Optional ops escape hatch (not for end users)
MCP_API_KEY=
# Allow X-PostHog-* headers for API-key principals in production (default off)
ALLOW_POSTHOG_HEADER_CREDENTIALS=

# Optional comma-separated browser Origins allowed for Streamable HTTP
MCP_ALLOWED_ORIGINS=
# Optional extra PostHog hostnames beyond us/eu cloud defaults
POSTHOG_ALLOWED_HOSTS=

# --- Agent evaluations (not required for npm test) ---
EVAL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_TPM_LIMIT=250000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TPM_LIMIT=8000
