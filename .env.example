# PostHog MCP — copy to .env and fill in values. Never commit real keys.

# mock (default) | live
POSTHOG_MODE=mock

# Project API key (phc_...) — required for live capture / decide
POSTHOG_API_KEY=

# Capture / decide host
POSTHOG_HOST=https://us.i.posthog.com

# Personal API key (phx_...) — required for live private REST + query tools
POSTHOG_PERSONAL_API_KEY=

# Numeric project id — required for live private API paths
POSTHOG_PROJECT_ID=

# --- Agent evaluations (not required for npm test / npm run eval) ---

# Active provider: gemini | groq (default: gemini if GEMINI_API_KEY set, else groq)
EVAL_PROVIDER=gemini

# Gemini (recommended on free tier — ~250k TPM for Flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_TPM_LIMIT=250000

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TPM_LIMIT=8000
