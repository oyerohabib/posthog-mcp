{
  "name": "posthog-mcp",
  "version": "1.0.0",
  "description": "PostHog-flavored MCP server agents can drive \u2014 mock by default, optional live API, Groq agent evals",
  "type": "module",
  "bin": {
    "posthog-mcp": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "start:http": "node dist/src/http.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "eval": "tsx eval/harness.ts",
    "test": "tsx eval/harness.ts && tsx eval/http-harness.ts",
    "eval:agent": "tsx eval/run-agent.ts",
    "eval:compare": "tsx eval/run-compare.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "posthog",
    "agents",
    "model-context-protocol",
    "groq",
    "evaluation"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "dotenv": "^18.0.4",
    "zod": "^4.6.5",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@types/node": "^22.0.0 || ^26.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
